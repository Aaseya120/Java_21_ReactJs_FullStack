        },
        {
          "name": "Product Service Health (Direct :8083)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{product_service_url}}/actuator/health", "host": ["{{product_service_url}}"], "path": ["actuator","health"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Product Service is UP', () => pm.response.to.have.status(200));"
