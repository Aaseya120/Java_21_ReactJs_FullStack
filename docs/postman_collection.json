				{
					"name": "Update Order Status → CONFIRMED",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{gateway_url}}/api/v1/orders/{{order_id}}/status?status=CONFIRMED",
							"host": [
								"{{gateway_url}}"
							],
							"path": [
								"api",
								"v1",
								"orders",
								"{{order_id}}",
								"status"
							],
							"query": [
								{
									"key": "status",
									"value": "CONFIRMED"
								}
