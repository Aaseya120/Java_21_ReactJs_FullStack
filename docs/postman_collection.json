        },
        {
          "name": "Notification Service Health (Direct :8084)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{notification_service_url}}/actuator/health", "host": ["{{notification_service_url}}"], "path": ["actuator","health"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Notification Service is UP', () => pm.response.to.have.status(200));"
          ]}}]
        },
        {
          "name": "Payment Service Health (Direct :8085)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{payment_service_url}}/actuator/health", "host": ["{{payment_service_url}}"], "path": ["actuator","health"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Payment Service is UP', () => pm.response.to.have.status(200));"
