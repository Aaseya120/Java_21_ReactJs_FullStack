          "name": "Gateway Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{gateway_url}}/actuator/health", "host": ["{{gateway_url}}"], "path": ["actuator","health"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Gateway is UP', () => pm.response.to.have.status(200));",
            "pm.test('Status is UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
          ]}}]
        },
        {
          "name": "User Service Health (Direct :8081)",
          "request": {
