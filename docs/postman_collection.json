              "raw": "{{gateway_url}}/api/v1/aggregator/order-details/{{order_id}}",
              "host": ["{{gateway_url}}"],
              "path": ["api","v1","aggregator","order-details","{{order_id}}"]
            },
            "description": "Returns a merged view of the order + its product details fetched concurrently from order-service and product-service."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Aggregated response OK (200)', () => pm.response.to.have.status(200));",
            "pm.test('Contains order and product keys', () => {",
            "    const data = pm.response.json().data;",
            "    pm.expect(data).to.have.any.keys('order', 'product');",
            "});"
          ]}}]
        }
      ]
    },

    {
      "name": "6️⃣ Notifications",
      "description": "Notification service endpoints.\n\n> SSE (Server-Sent Events) streams are not fully supported in Postman — use a browser or `curl` for the live stream.",
      "item": [
        {
          "name": "Notification Service Status (Direct :8084)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{notification_service_url}}/api/notifications/status",
              "host": ["{{notification_service_url}}"],
              "path": ["api","notifications","status"]
            },
            "description": "Direct health/status check for the notification service (bypasses gateway)."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Notification Status OK (200)', () => pm.response.to.have.status(200));"
          ]}}]
        },
        {
          "name": "SSE Stream (via Gateway)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "text/event-stream" }],
            "url": {
              "raw": "{{gateway_url}}/api/v1/notifications/stream/{{user_id}}",
              "host": ["{{gateway_url}}"],
              "path": ["api","v1","notifications","stream","{{user_id}}"]
            },
            "description": "Real-time SSE notification stream per user.\n\n⚠️ Postman has limited SSE support. For full streaming use:\n```\ncurl -N -H 'Authorization: Bearer {{access_token}}' http://localhost:8080/api/v1/notifications/stream/{{user_id}}\n```"
          }
        }
      ]
    },

    {
      "name": "6️⃣ Payments (Tokenized PCI-DSS, UPI & NetBanking)",
      "description": "Payment processing lifecycle with RSA-2048 tokenization, idempotency keys, and refund workflows.",
      "item": [
        {
          "name": "Process Payment (Credit Card)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Idempotency-Key", "value": "{{idempotency_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"orderId\": {{order_id}},\n    \"userId\": {{user_id}},\n    \"amount\": 99.99,\n    \"currency\": \"USD\",\n    \"paymentMethod\": \"CREDIT_CARD\",\n    \"idempotencyKey\": \"{{idempotency_key}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{gateway_url}}/api/v1/payments", "host": ["{{gateway_url}}"], "path": ["api","v1","payments"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Payment Processed (200/201)', () => pm.expect([200, 201]).to.include(pm.response.code));",
            "const body = pm.response.json();",
            "const data = body.data || body;",
            "if (data.id) {",
            "    pm.collectionVariables.set('payment_id', data.id);",
            "    console.log('✅ payment_id saved:', data.id);",
            "}"
          ]}}]
        },
        {
          "name": "Get Payment by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{gateway_url}}/api/v1/payments/{{payment_id}}", "host": ["{{gateway_url}}"], "path": ["api","v1","payments","{{payment_id}}"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Get Payment OK (200)', () => pm.response.to.have.status(200));"
          ]}}]
        },
        {
          "name": "Get Payments by Order ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{gateway_url}}/api/v1/payments/order/{{order_id}}", "host": ["{{gateway_url}}"], "path": ["api","v1","payments","order","{{order_id}}"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Get Order Payments OK (200)', () => pm.response.to.have.status(200));"
          ]}}]
        },
        {
          "name": "Refund Payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"reason\": \"Customer requested refund\",\n    \"amount\": 99.99\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{gateway_url}}/api/v1/payments/{{payment_id}}/refund", "host": ["{{gateway_url}}"], "path": ["api","v1","payments","{{payment_id}}","refund"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Refund Succeeded (200/202)', () => pm.expect([200, 202]).to.include(pm.response.code));"
          ]}}]
        }
      ]
    },

