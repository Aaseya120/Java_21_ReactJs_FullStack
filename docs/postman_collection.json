    {
      "name": "5️⃣ Aggregator",
      "description": "Aggregator pattern — combines Order + Product data concurrently using CompletableFuture.\n\nRouted through the gateway to the order-service on `/api/v1/aggregator/**`.",
      "item": [
        {
          "name": "Get Order Details (Aggregated)",
          "request": {
            "method": "GET",
            "header": [],
