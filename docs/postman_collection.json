    {
      "name": "1️⃣ Auth",
      "description": "**Run Register then Login FIRST.** Login auto-saves `access_token`, `refresh_token`, and `user_id`. All subsequent requests use the saved token automatically via collection-level auth.",
      "item": [
        {
          "name": "Register User",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"fullName\": \"John Doe\",\n    \"email\": \"john.doe@example.com\",\n    \"password\": \"P@ssword123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{gateway_url}}/api/v1/auth/register", "host": ["{{gateway_url}}"], "path": ["api","v1","auth","register"] },
            "description": "Register a new user. Open endpoint — no token required.\n\nIf the email already exists you will get a 409 — just proceed to Login."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const code = pm.response.code;",
            "pm.test('Register succeeded (201) or user exists (409)', () => {",
            "    pm.expect([201, 409]).to.include(code);",
            "});",
            "if (code === 201) {",
            "    const body = pm.response.json();",
            "    if (body.data && body.data.accessToken) {",
            "        pm.collectionVariables.set('access_token', body.data.accessToken);",
            "        pm.collectionVariables.set('refresh_token', body.data.refreshToken);",
            "    }",
            "    if (body.data && body.data.user && body.data.user.id) {",
            "        pm.collectionVariables.set('user_id', body.data.user.id);",
            "        console.log('✅ user_id saved:', body.data.user.id);",
            "    }",
            "}"
          ]}}]
        },
        {
          "name": "Login User",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"john.doe@example.com\",\n    \"password\": \"P@ssword123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{gateway_url}}/api/v1/auth/login", "host": ["{{gateway_url}}"], "path": ["api","v1","auth","login"] },
            "description": "Authenticate and receive JWT tokens. Open endpoint — no token required.\n\n**Auto-saves:** `access_token`, `refresh_token`, `user_id`"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Login OK (200)', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "if (body.data) {",
            "    if (body.data.accessToken) {",
            "        pm.collectionVariables.set('access_token', body.data.accessToken);",
            "        console.log('✅ access_token saved');",
            "    }",
            "    if (body.data.refreshToken) {",
            "        pm.collectionVariables.set('refresh_token', body.data.refreshToken);",
            "        console.log('✅ refresh_token saved');",
            "    }",
            "    if (body.data.user && body.data.user.id) {",
            "        pm.collectionVariables.set('user_id', body.data.user.id);",
            "        console.log('✅ user_id saved:', body.data.user.id);",
            "    }",
            "}"
          ]}}]
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refreshToken\": \"{{refresh_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{gateway_url}}/api/v1/auth/refresh", "host": ["{{gateway_url}}"], "path": ["api","v1","auth","refresh"] },
            "description": "Exchange a refresh token for a new access token. Run this when your access token expires."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Refresh OK (200)', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "if (body.data && body.data.accessToken) {",
            "    pm.collectionVariables.set('access_token', body.data.accessToken);",
            "    pm.collectionVariables.set('refresh_token', body.data.refreshToken);",
            "    console.log('✅ Tokens refreshed');",
            "}"
          ]}}]
        }
      ]
    },

    {
      "name": "2️⃣ Users",
      "description": "User profile management. Requires JWT — run Login first.\n\nToken is applied automatically via collection-level Bearer auth.",
      "item": [
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/users/{{user_id}}",
              "host": ["{{gateway_url}}"],
              "path": ["api","v1","users","{{user_id}}"]
            },
            "description": "Retrieve a user profile by UUID. Result is cached in Redis."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Get User OK (200)', () => pm.response.to.have.status(200));",
            "pm.test('Has user data', () => pm.expect(pm.response.json().data).to.exist);"
          ]}}]
        },
        {
          "name": "Update User Name",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/users/{{user_id}}/name?fullName=Jane Doe Updated",
              "host": ["{{gateway_url}}"],
              "path": ["api","v1","users","{{user_id}}","name"],
              "query": [{ "key": "fullName", "value": "Jane Doe Updated" }]
            },
            "description": "Update the full name of a user. Only the user themselves or an ADMIN can update."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Update Name OK (200)', () => pm.response.to.have.status(200));"
          ]}}]
        }
      ]
    },

    {
      "name": "3️⃣ Products",
      "description": "Product catalog CRUD. Requires JWT — run Login first.\n\n**Run Create Product before placing an order** — it auto-saves `product_id`.",
      "item": [
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"MacBook Pro 16\",\n    \"description\": \"Apple MacBook Pro 16-inch with M3 Max chip\",\n    \"price\": 2499.99,\n    \"stockQty\": 50,\n    \"category\": \"Electronics\",\n    \"sku\": \"MBP-16-M3MAX\",\n    \"imageUrl\": \"https://example.com/macbook-pro-16.jpg\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{gateway_url}}/api/v1/products", "host": ["{{gateway_url}}"], "path": ["api","v1","products"] },
            "description": "Create a new product. **Auto-saves** `product_id` for use in Order creation."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Create Product (201)', () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "if (body.data && body.data.id) {",
            "    pm.collectionVariables.set('product_id', body.data.id);",
            "    console.log('✅ product_id saved:', body.data.id);",
            "}"
          ]}}]
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/products/{{product_id}}",
              "host": ["{{gateway_url}}"],
              "path": ["api","v1","products","{{product_id}}"]
            },
            "description": "Get a single product by UUID. Cached in Redis."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Get Product OK (200)', () => pm.response.to.have.status(200));"
          ]}}]
        },
        {
          "name": "Get All Products (Paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/products?page=0&size=20&sort=name",
              "host": ["{{gateway_url}}"],
              "path": ["api","v1","products"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "name" }
              ]
            },
            "description": "List all products with pagination. Supports `page`, `size`, and `sort` query params."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('List Products OK (200)', () => pm.response.to.have.status(200));"
          ]}}]
        },
        {
          "name": "Get Products by Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/products/category/Electronics",
              "host": ["{{gateway_url}}"],
              "path": ["api","v1","products","category","Electronics"]
            },
            "description": "Filter products by category name. Change `Electronics` in the URL to any category."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Get By Category OK (200)', () => pm.response.to.have.status(200));"
          ]}}]
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"MacBook Pro 16 (Updated)\",\n    \"description\": \"Apple MacBook Pro 16-inch with M3 Max — 2024 Edition\",\n    \"price\": 2599.99,\n    \"stockQty\": 45,\n    \"category\": \"Electronics\",\n    \"sku\": \"MBP-16-M3MAX-2024\",\n    \"imageUrl\": \"https://example.com/macbook-pro-16-2024.jpg\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{gateway_url}}/api/v1/products/{{product_id}}",
              "host": ["{{gateway_url}}"],
              "path": ["api","v1","products","{{product_id}}"]
            },
            "description": "Update all fields of an existing product."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Update Product OK (200)', () => pm.response.to.have.status(200));"
          ]}}]
        },
        {
          "name": "Add Stock",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/products/{{product_id}}/stock/add?quantity=100",
              "host": ["{{gateway_url}}"],
              "path": ["api","v1","products","{{product_id}}","stock","add"],
              "query": [{ "key": "quantity", "value": "100" }]
            },
            "description": "Add stock quantity to a product. Triggers a `STOCK_ADDED` Kafka event."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Add Stock OK (200)', () => pm.response.to.have.status(200));"
          ]}}]
        },
        {
          "name": "Deduct Stock",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/products/{{product_id}}/stock/deduct?quantity=5",
              "host": ["{{gateway_url}}"],
              "path": ["api","v1","products","{{product_id}}","stock","deduct"],
              "query": [{ "key": "quantity", "value": "5" }]
            },
            "description": "Deduct stock quantity from a product. Returns 409 if insufficient stock."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Deduct Stock OK (200 or 409)', () => {",
            "    pm.expect([200, 409]).to.include(pm.response.code);",
            "});"
          ]}}]
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/products/{{product_id}}",
              "host": ["{{gateway_url}}"],
              "path": ["api","v1","products","{{product_id}}"]
            },
            "description": "Delete a product. Creates an Outbox event for downstream consumers."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Delete Product (204)', () => pm.response.to.have.status(204));"
          ]}}]
        }
      ]
    },

    {
      "name": "4️⃣ Orders",
      "description": "Order management. Requires JWT — run Login first.\n\n**Prerequisite:** Create a Product first to get `product_id`. Create Order auto-saves `order_id`.",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}", "description": "Prevents duplicate orders on retry" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"userId\": \"{{user_id}}\",\n    \"productId\": \"{{product_id}}\",\n    \"quantity\": 2,\n    \"totalPrice\": 4999.98,\n    \"notes\": \"Please deliver before Friday\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{gateway_url}}/api/v1/orders", "host": ["{{gateway_url}}"], "path": ["api","v1","orders"] },
            "description": "Create a new order. Uses `Idempotency-Key` header (auto-generated GUID) to prevent duplicate submissions.\n\n**Auto-saves:** `order_id`"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Create Order (201)', () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "if (body.data && body.data.id) {",
            "    pm.collectionVariables.set('order_id', body.data.id);",
            "    console.log('✅ order_id saved:', body.data.id);",
            "}"
          ]}}]
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/orders/{{order_id}}",
              "host": ["{{gateway_url}}"],
              "path": ["api","v1","orders","{{order_id}}"]
            },
            "description": "Get an order by UUID. Result is cached in Redis."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Get Order OK (200)', () => pm.response.to.have.status(200));"
          ]}}]
        },
        {
          "name": "Get All Orders (Paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/orders?page=0&size=20&sort=createdAt",
              "host": ["{{gateway_url}}"],
              "path": ["api","v1","orders"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "createdAt" }
              ]
            },
            "description": "List all orders with pagination. Admin endpoint."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('List Orders OK (200)', () => pm.response.to.have.status(200));"
          ]}}]
        },
        {
          "name": "Get Orders by User ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/orders/user/{{user_id}}",
              "host": ["{{gateway_url}}"],
              "path": ["api","v1","orders","user","{{user_id}}"]
            },
            "description": "Get all orders for a specific user."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Get Orders by User OK (200)', () => pm.response.to.have.status(200));"
          ]}}]
        },
        {
          "name": "Update Status → CONFIRMED",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/orders/{{order_id}}/status?status=CONFIRMED",
              "host": ["{{gateway_url}}"],
              "path": ["api","v1","orders","{{order_id}}","status"],
              "query": [{ "key": "status", "value": "CONFIRMED" }]
            },
            "description": "Transition order using the state machine.\n\n**Valid status flow:** PENDING → CONFIRMED → PROCESSING → SHIPPED → DELIVERED\n\nCan also be set to: CANCELLED, REFUNDED"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status Updated (200)', () => pm.response.to.have.status(200));"
          ]}}]
        },
        {
          "name": "Update Status → PROCESSING",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/orders/{{order_id}}/status?status=PROCESSING",
              "host": ["{{gateway_url}}"],
              "path": ["api","v1","orders","{{order_id}}","status"],
              "query": [{ "key": "status", "value": "PROCESSING" }]
            }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status Updated (200)', () => pm.response.to.have.status(200));"
          ]}}]
        },
        {
          "name": "Update Status → SHIPPED",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/orders/{{order_id}}/status?status=SHIPPED",
              "host": ["{{gateway_url}}"],
              "path": ["api","v1","orders","{{order_id}}","status"],
              "query": [{ "key": "status", "value": "SHIPPED" }]
            }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status Updated (200)', () => pm.response.to.have.status(200));"
          ]}}]
        },
        {
          "name": "Update Status → DELIVERED",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
