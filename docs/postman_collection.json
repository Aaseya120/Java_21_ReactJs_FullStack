{
  "info": {
    "_postman_id": "java21-microservices-v2",
    "name": "Java 21 Microservices — Full Stack Guide v2",
    "description": "## Complete Postman Collection\n\nAll endpoints for all 5 microservices routed through the API Gateway.\n\n**Ports:**\n- API Gateway : 8080\n- User Service : 8081\n- Order Service : 8082\n- Product Service: 8083\n- Notification  : 8084\n\n**Run order:** Health Checks → Register → Login → Products → Orders → Aggregator → Notifications\n\n> JWT token is **auto-saved** after Login and applied via collection-level auth — no manual header setup needed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "gateway_url",            "value": "http://localhost:8080", "type": "string" },
    { "key": "user_service_url",       "value": "http://localhost:8081", "type": "string" },
    { "key": "order_service_url",      "value": "http://localhost:8082", "type": "string" },
    { "key": "product_service_url",    "value": "http://localhost:8083", "type": "string" },
    { "key": "notification_service_url","value": "http://localhost:8084", "type": "string" },
    { "key": "payment_service_url",    "value": "http://localhost:8085", "type": "string" },
    { "key": "access_token",           "value": "", "type": "string" },
    { "key": "refresh_token",          "value": "", "type": "string" },
    { "key": "user_id",                "value": "", "type": "string" },
    { "key": "product_id",             "value": "", "type": "string" },
    { "key": "order_id",               "value": "", "type": "string" },
    { "key": "payment_id",             "value": "", "type": "string" },
    { "key": "idempotency_key",        "value": "IDEM-WEB-001", "type": "string" }
  ],
  "item": [

    {
      "name": "🏥 Health Checks",
      "description": "Verify all services are running before making API calls.",
      "item": [
